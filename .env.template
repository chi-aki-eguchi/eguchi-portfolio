# Runtime
NODE_ENV=development
PORT=4200

# Public site origin. Used for sitemap, canonical URLs, OGP, and JSON-LD.
# In production, set this to the final custom domain, for example:
# SITE_URL=https://example.com
SITE_URL=http://localhost:4200

# Admin login. Leave empty only when you intentionally want /admin disabled.
# Unset symptom: /admin/login returns a server setting error and nobody can edit.
ADMIN_PASSWORD=

# Database: Turso/libSQL
# Unset symptom: API routes that read or write content fail.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Object storage: Cloudflare R2 / S3-compatible
# Unset symptom: image upload and image proxy routes fail.
S3_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional template defaults. Fill these for a reusable fork so a fresh database
# does not show the original production site's identity before admin setup.
DEFAULT_SITE_NAME=Photographer Name
DEFAULT_SITE_NAME_EN=Photographer Name
DEFAULT_SITE_DESCRIPTION=Photography portfolio.
DEFAULT_PROFILE_NAME=Photographer Name
DEFAULT_PROFILE_NAME_KATA=
DEFAULT_PROFILE_NAME_EN=Photographer Name
DEFAULT_PROFILE_BIO=Photographer.

# Optional CORS extension. Comma-separated extra origins for credentialed API
# requests. localhost and SITE_URL are already allowed. Add explicit variants
# such as https://www.example.com here if both apex and www domains are used.
ALLOWED_ORIGINS=

# Optional analytics. Empty disables GA for template installs. The production
# akieguchi.com deployment keeps its legacy GA fallback unless this is set.
GA_MEASUREMENT_ID=
